# syntax=docker/dockerfile:1
# Prod: multi-stage standalone. bookworm-slim (not alpine) — LibreOffice
# headless (approved conversion engine for legacy DOC/ODT/RTF lanes) needs
# glibc. Converted files live in tmp only and are deleted after response.
FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package*.json ./
# Coolify can inject NODE_ENV=production into every stage. CSS and TypeScript
# tooling are devDependencies but are required to build the production app.
RUN --mount=type=cache,target=/root/.npm npm ci --include=dev

FROM node:20-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# This app stores its icons/fonts under app/; public/ may not exist in Git.
# Ensure the optional directory exists for the runtime COPY below.
RUN mkdir -p public
# PORT must be declared here (not just in the production stage): env.ts
# validates it while prerendering, and .env.local never reaches the build
# context (gitignored) — without this, Coolify's --build-arg PORT lands
# nowhere and the build dies with "Invalid server environment variables".
ARG PORT
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_APP_NAME
ENV PORT=${PORT}
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME}
ENV NEXT_TELEMETRY_DISABLED=1
RUN --mount=type=cache,target=/app/.next/cache npm run build

FROM node:20-bookworm-slim AS production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    poppler-utils \
    fonts-dejavu \
    wget \
  && rm -rf /var/lib/apt/lists/* \
  && addgroup --system appgroup && adduser --system --ingroup appgroup appuser

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ARG PORT
ENV PORT=${PORT}
ENV HOSTNAME=0.0.0.0

COPY --from=builder --chown=appuser:appgroup /app/.next/standalone ./
COPY --from=builder --chown=appuser:appgroup /app/.next/static ./.next/static
COPY --from=builder --chown=appuser:appgroup /app/public ./public

USER appuser
EXPOSE ${PORT}
CMD ["node", "server.js"]

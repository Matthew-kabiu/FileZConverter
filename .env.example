# App
NODE_ENV=development
PORT=CHANGE_ME_APP_PORT
FRONTEND_PORT=CHANGE_ME_EXTERNAL_PORT

# Public (inlined into the client bundle — NEVER secrets)
# Dev points at localhost; prod points at the live domain (baked at build time).
NEXT_PUBLIC_API_BASE_URL=http://localhost:CHANGE_ME_APP_PORT/api
NEXT_PUBLIC_APP_NAME=FilezConverter
# Optional: GitHub link in the header. Leave empty to hide it.
NEXT_PUBLIC_REPO_URL=CHANGE_ME_REPO_URL

# Auth (Better Auth, server-only — never NEXT_PUBLIC_*).
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_64_HEX_CHARS
# Public origin of the app (browser-facing URL, baked per environment).
BETTER_AUTH_URL=https://CHANGE_ME_APP_DOMAIN

# AI vault master key (AES-256-GCM, server-only). Generate with: openssl rand -hex 32
# Losing it orphans every saved provider key. Back it up with the data/ volume.
AI_VAULT_KEY=CHANGE_ME_64_HEX_CHARS

# AI providers (all server-only). Per-user vault keys win; these are fallbacks.
# AI_CHAT_PROVIDER=openai|openrouter|anthropic|gemini (unset = user must pick)
# AI_CHAT_MODEL= (unset = provider default)
AI_EMBED_PROVIDER=local
AI_EMBED_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX
# AI_OPENAI_API_KEY= / AI_ANTHROPIC_API_KEY= / AI_GEMINI_API_KEY= / AI_OPENROUTER_API_KEY= (optional fallbacks)
# OpenRouter base URL (OpenAI-compatible). No hardcoded base URLs in code.
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# RAG session TTL in hours (Redis + sweeper backstop).
AI_RAG_TTL_HOURS=24
# Redis (password-protected). Generate with: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_48_HEX_CHARS
# Local dev uses @localhost; Docker compose uses @redis (service name).
REDIS_URL=redis://:CHANGE_ME_48_HEX_CHARS@redis:6379
